# Copy to .env (for docker compose) or backend/.env (for running the backend directly).
# Never commit the real file.

# Which AI reads the messages:
#   anthropic = Claude API (best quality, a few cents per scan, needs ANTHROPIC_API_KEY)
#   ollama    = a model running on your own computer (free, screenshots never leave the machine)
LLM_PROVIDER=anthropic

# Claude: get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high

# Ollama: install from https://ollama.com, then `ollama pull qwen3.5:35b`. The model must support vision.
# OLLAMA_MODEL=qwen3.5:35b
# OLLAMA_THINK=false             # thinking models are slower; false is usually good enough here
# OLLAMA_BASE_URL=http://localhost:11434   # docker compose overrides this to reach your Mac

# Optional
# NETWORK_CHECKS=true            # domain-age lookups + phishing blocklists
# RATE_LIMIT_PER_MINUTE=10
