# Fly.io image: the regular backend plus Tailscale, so the app can reach the Ollama model on your
# own computer over a private network. Ollama is never exposed to the internet.
FROM docker.io/tailscale/tailscale:v1.104.1 AS tailscale

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscale /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends iptables ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app
COPY fly-start.sh /fly-start.sh
RUN useradd --create-home appuser && chown -R appuser /app && chmod 755 /fly-start.sh

EXPOSE 8000
# Starts as root only to bring up Tailscale; the app itself runs as appuser.
CMD ["/fly-start.sh"]
